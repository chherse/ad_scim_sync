# =============================================================================
# Konfiguration fuer ad_group_scim_sync.py
# =============================================================================
# Verwendung:
#   1. Diese Datei nach ".env" kopieren und die Werte anpassen.
#   2. Dateiberechtigungen auf den ausfuehrenden Service-Account beschraenken
#      (enthaelt Passwort und Token!). Die .env niemals committen.
#   3. Aufruf: python ad_group_scim_sync.py --env-file .env
#
# Hinweise zum Format:
#   - Ein Eintrag pro Zeile im Format KEY=VALUE.
#   - Kommentare nur in eigenen Zeilen mit "#" am Zeilenanfang. Kommentare hinter
#     einem Wert (z. B. "KEY=wert # Kommentar") werden NICHT erkannt und wuerden
#     Teil des Werts werden.
#   - Anfuehrungszeichen um Werte sind optional.
#   - Bereits gesetzte Umgebungsvariablen haben Vorrang vor dieser Datei.
#   - Pflichtwerte sind unten mit [PFLICHT] gekennzeichnet, alle anderen sind
#     optional und mit "#" auskommentiert bzw. mit Standardwert vorbelegt.

# -----------------------------------------------------------------------------
# Zielgruppe
# -----------------------------------------------------------------------------

# GROUP_DN  [PFLICHT, sofern nicht als Kommandozeilenargument uebergeben]
# Distinguished Name der AD-Gruppe, deren Mitglieder synchronisiert werden.
# Aus der Gruppe wird auch die Such-Basis (DC=...-Teil) fuer die LDAP-Suche
# abgeleitet. Ein auf der Kommandozeile uebergebener DN hat Vorrang vor diesem Wert.
# Bei mehreren Gruppen das Skript mehrfach mit je eigenem DN bzw. eigener .env
# aufrufen (die State-Datei ist an genau eine Gruppe gebunden).
GROUP_DN=CN=SCIM-Sync,OU=Groups,DC=example,DC=local

# -----------------------------------------------------------------------------
# Quelle: Active Directory (LDAP)
# -----------------------------------------------------------------------------

# LDAP_SERVER  [PFLICHT]
# Adresse des Domain Controllers. Es wird ausschliesslich verschluesseltes LDAPS
# akzeptiert; "ldap://" (Klartext) wird vom Skript abgelehnt.
LDAP_SERVER=ldaps://dc01.example.local

# LDAP_USER  [PFLICHT]
# Service-Account fuer die Abfrage (Leserechte auf Gruppe und Benutzer genuegen).
# Zwei Schreibweisen:
#   DOMAIN\user   -> Anmeldung per NTLM
#   user@domain   -> Anmeldung per Simple Bind (UPN)
LDAP_USER=EXAMPLE\svc-scim

# LDAP_PASSWORD  [PFLICHT]
# Passwort des Service-Accounts. Vertraulich - nicht loggen, nicht weitergeben.
LDAP_PASSWORD=

# LDAP_CA_FILE  [optional]
# Pfad zu einem CA-Zertifikatsbundle (PEM), mit dem das Zertifikat des Domain
# Controllers geprueft wird. Nur noetig, wenn die interne CA nicht ohnehin im
# Zertifikatsspeicher des Systems vertraut ist. Die Pruefung selbst ist immer aktiv.
#LDAP_CA_FILE=C:\certs\ad-ca.pem

# -----------------------------------------------------------------------------
# Ziel: Identity Provider (SCIM 2.0)
# -----------------------------------------------------------------------------

# SCIM_URL  [PFLICHT]
# Basis-URL des SCIM-2.0-Endpunkts des IdP (ohne /Users am Ende).
# Nur HTTPS ist erlaubt; "http://" wird vom Skript abgelehnt.
SCIM_URL=https://idp.example.com/scim/v2

# SCIM_SECRET  [PFLICHT]
# Bearer-Token fuer die Authentifizierung am SCIM-Endpunkt des IdP.
# Vertraulich - wird nicht geloggt.
SCIM_SECRET=

# SCIM_CA_FILE  [optional]
# Pfad zu einem CA-Zertifikatsbundle (PEM) fuer die TLS-Pruefung des IdP.
# Nur noetig bei privater/interner CA; sonst leer lassen bzw. auskommentieren.
#SCIM_CA_FILE=

# -----------------------------------------------------------------------------
# Verhalten bei Entfernungen
# -----------------------------------------------------------------------------

# SCIM_REMOVE_MODE  [optional, Standard: deactivate]
# Was passiert mit Benutzern, die nicht mehr Mitglied der Gruppe sind?
#   deactivate -> Benutzer im IdP auf active=false setzen (reversibel, empfohlen)
#   delete     -> Benutzer im IdP endgueltig loeschen (DELETE)
SCIM_REMOVE_MODE=deactivate

# MAX_REMOVE_RATIO  [optional, Standard: 0.3]
# Sicherheitsgrenze gegen Massenentfernung (Dezimalzahl 0-1, mit Punkt).
# Wuerden mindestens 5 Mitglieder UND mehr als dieser Anteil des bisherigen
# Bestands entfernt (0.3 = 30 %), bricht der Lauf mit Exit-Code 2 ab, z. B. bei
# defekter LDAP-Antwort oder versehentlich geleerter Gruppe.
# Bewusstes Uebergehen ist mit dem Schalter --force moeglich.
MAX_REMOVE_RATIO=0.3
